{
  "name": "chutometro",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/api & npm run dev --workspace=packages/web",
    "build": "npm run build --workspace=packages/web",
    "start": "node packages/api/src/index.js",
    "migrate": "npm run migrate --workspace=packages/api"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
