PORT=3001
NODE_ENV=development

# JWT
JWT_SECRET=change-me-in-production

# Frontend URL (for magic link emails)
FRONTEND_URL=http://localhost:5173

# SMTP (optional in dev — magic links logged to console if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@chutometro.app

# football-data.org API key (optional)
FOOTBALL_API_KEY=

# SQLite database path
DB_PATH=./chutometro.db
