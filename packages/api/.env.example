PORT=3001
NODE_ENV=development

# JWT — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Frontend URL (used in magic link emails)
FRONTEND_URL=http://localhost:5173

# Resend (optional in dev — magic links logged to console if not set)
# Get a free key at https://resend.com
RESEND_API_KEY=

# football-data.org API key (optional — polling disabled if not set)
# Register free at https://www.football-data.org/client/register
FOOTBALL_API_KEY=

# SQLite database path
DB_PATH=./chutometro.db
